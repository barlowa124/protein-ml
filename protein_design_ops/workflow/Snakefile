"""design-ops DAG:

    backbone -> generate (ProteinMPNN) -> score (ESM-2)
        -> fold (ESMFold or Chai-1, config.fold.backend)
        -> selfconsistency (designs refolded onto the input backbone)
        -> report

Outputs are parameterized by config.backbone.id so multiple backbones
can coexist: run an alternate config with
    DESIGN_CONFIG=config/config_1ubq.yaml snakemake
"""

import os
import sys

configfile: os.environ.get("DESIGN_CONFIG", "config/config.yaml")

PY = sys.executable  # keeps the DAG on the project venv
BB = config["backbone"].get("id", "run")
PROC = f"data/processed/{BB}"
RES = f"results/{BB}"


rule all:
    input:
        f"{RES}/design_report.json",
        f"{RES}/consensus.png",


rule backbone:
    output:
        f"{PROC}/backbone.json",
    shell:
        "{PY} -m design_ops.backbone {output}"


rule generate:
    input:
        f"{PROC}/backbone.json",
    output:
        f"{PROC}/candidates.json",
    shell:
        "{PY} -m design_ops.generate {input} {output}"


rule score:
    input:
        f"{PROC}/candidates.json",
    output:
        f"{PROC}/scores.json",
    shell:
        "{PY} -m design_ops.score {input} {output}"


rule fold:
    # Structure screen; backend picked by config.fold.backend.
    # esmfold: in-process, ~2.4 GB weights on first run.
    # chai1:   subprocess via config.chai.command (separate env,
    #          chai_lab requires torch<2.7) + ~4 GB weights.
    input:
        f"{PROC}/scores.json",
    output:
        f"{PROC}/fold.json",
    params:
        module=("design_ops.chai"
                if config.get("fold", {}).get("backend") == "chai1"
                else "design_ops.fold"),
    shell:
        "{PY} -m {params.module} {input} {output} {RES}/folds"


rule selfconsistency:
    # CA RMSD of each folded structure vs the input backbone
    input:
        fold=f"{PROC}/fold.json",
        backbone=f"{PROC}/backbone.json",
    output:
        f"{PROC}/sc.json",
    shell:
        "{PY} -m design_ops.selfconsistency {input.fold} {input.backbone} "
        "{output}"


rule report:
    input:
        scores=f"{PROC}/scores.json",
        backbone=f"{PROC}/backbone.json",
        fold=f"{PROC}/sc.json",
    output:
        report=f"{RES}/design_report.json",
        figure=f"{RES}/consensus.png",
    shell:
        "{PY} -m design_ops.report {input.scores} {input.backbone} "
        "{output.report} {output.figure} {input.fold}"
